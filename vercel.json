{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/(.*)",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/login.html"
    },
    {
      "source": "/login",
      "destination": "/public/login.html"
    },
    {
      "source": "/cadastro",
      "destination": "/public/cadastro.html"
    },
    {
      "source": "/game",
      "destination": "/public/index.html"
    },
    {
      "source": "/register",
      "destination": "/server/server.js"
    },
    {
      "source": "/login-api",
      "destination": "/server/server.js"
    },
    {
      "source": "/words",
      "destination": "/server/server.js"
    },
    {
      "source": "/ranking",
      "destination": "/server/server.js"
    },
    {
      "source": "/score",
      "destination": "/server/server.js"
    },
    {
      "source": "/update-cosmetics",
      "destination": "/server/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
